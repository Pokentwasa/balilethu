# Public site URL used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://balilethulivestock.com
# WhatsApp number in international format, digits only (overrides src/config/site.ts).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Set to "false" before launch to hide the "content to confirm" development markers.
NEXT_PUBLIC_SHOW_CONTENT_FLAGS=true
